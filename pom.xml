<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hitorro</groupId>
    <artifactId>hitorro-mesh-examples</artifactId>
    <version>3.0.1</version>
    <packaging>jar</packaging>

    <name>hitorro-mesh-examples</name>
    <description>Runnable examples of the Hitorro Mesh. Each example spins up an in-JVM cluster (driver + N agents on an InMemoryMeshTransport), loads sample data, runs canned queries, prints the merged results. Same code path swaps in NatsMeshTransport later. Also serves as the integration test surface for the mesh modules.</description>

    <properties>
        <hitorro.deploy.repo.path>${user.home}/code/hitorro-maven</hitorro.deploy.repo.path>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-core</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-agent</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-driver</artifactId>
            <version>3.0.1</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.24.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <distributionManagement>
        <repository>
            <id>hitorro-local</id>
            <url>file://${hitorro.deploy.repo.path}</url>
        </repository>
    </distributionManagement>
</project>
