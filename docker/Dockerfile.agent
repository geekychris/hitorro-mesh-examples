# Runtime image for a mesh agent. Same fat-JAR strategy as the driver —
# build the JAR outside the container, copy it in here.
#
# Phase 7e — production hardening (mirrors Dockerfile.driver):
#   - non-root user (uid 1000)
#   - tuned JVM: 512M initial / 3G max (agents buffer partials so give them a
#     bit more headroom than the driver)
#   - HEALTHCHECK — agent-app exposes actuator on its own port
FROM eclipse-temurin:21-jre

ARG AGENT_JAR=hitorro-mesh-agent-app/target/hitorro-mesh-agent-app-3.0.1.jar

RUN groupadd --gid 1000 mesh && useradd --uid 1000 --gid mesh --home /home/mesh --create-home --shell /usr/sbin/nologin mesh
RUN mkdir -p /app /config /data && chown -R mesh:mesh /app /config /data

COPY --chown=mesh:mesh $AGENT_JAR /app/agent.jar
USER mesh
WORKDIR /home/mesh

ENV SPRING_CONFIG_LOCATION=file:/config/agent.yml
ENV JAVA_OPTS="-Xms512m -Xmx3g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/tmp"

EXPOSE 8091

HEALTHCHECK --interval=5s --timeout=3s --start-period=15s --retries=6 \
    CMD wget -q -O- http://localhost:8091/actuator/health | grep -q '"status":"UP"' || exit 1

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/agent.jar"]
